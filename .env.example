# Server-only shared beta configuration. Root / remains the local preview.
# Fill these only for this app's dedicated development Supabase project.
SCRABBLE_SUPABASE_URL=
SCRABBLE_SUPABASE_PUBLISHABLE_KEY=
SCRABBLE_APP_ORIGIN=http://127.0.0.1:3000
# Set google after configuring that provider. Omitted defaults to legacy email OTP.
SCRABBLE_AUTH_METHOD=google
SCRABBLE_FAMILY_ID=
# Dedicated non-owner login granted membership in scrabble_runtime.
# Never use postgres, supabase_admin, or an owner/service credential here.
SCRABBLE_DATABASE_URL=
# Optional PEM root certificate for private-CA database TLS (see config/certs/README.md).
# Set this to certificate contents, not a file path; actual or escaped \n are accepted.
# Leave absent to use system trust. Empty or malformed values fail closed.
# SCRABBLE_DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----"
# Intended owner: owner@example.test. Bootstrap requires the verified Auth UUID.
# Operator credentials are supplied only to the bootstrap/migration process,
# never to the Next.js application environment.

# Enable the shared games hub and Crokinole writes only after its migration.
# Existing Crokinole reads remain available when disabled.
AMBERLY_CROKINOLE_ENABLED=false
